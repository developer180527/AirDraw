+}
+
+// AirDraw: while nothing is drawn (low-processor mode skips unchanged frames), no touch is down
+// and no input arrives, the loop still ticks at the display rate; after idle_after_msec slow it
+// to idle_frame_rate. Timers keep running at that rate.
+- (void)airdrawUpdateIdle {
+	if (airdraw_idle_rate <= 0 || !self.displayLink || !OS::get_singleton()) {
+		return;
+	}
+	const uint64_t now = OS::get_singleton()->get_ticks_usec();
+	const uint64_t drawn = Engine::get_singleton()->get_frames_drawn();
+	bool touch_down = false;
+	for (int i = 0; i < max_touches; i++) {
+		touch_down = touch_down || godot_touches[i] != nullptr;
+	}
+	if (drawn != airdraw_frames_drawn || touch_down) {
+		// Something is changing on screen (an animation a timer started, say): full rate.
+		airdraw_frames_drawn = drawn;
+		airdraw_last_activity_usec = now;
+		if (airdraw_throttled) {
+			airdraw_throttled = NO;
+			self.displayLink.preferredFramesPerSecond = self.preferredFrameRate;
+		}
+	}
+	if (!airdraw_throttled && now - airdraw_last_activity_usec > airdraw_idle_after_usec) {
+		airdraw_throttled = YES;
+		self.displayLink.preferredFramesPerSecond = airdraw_idle_rate;
+	}
+}
