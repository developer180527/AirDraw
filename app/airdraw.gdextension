[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

[libraries]
; Release libraries for every build: the canvas's latency and the smoke test's timing are
; only meaningful optimised. `cargo build --release -p airdraw-godot` builds them.
macos = "res://../rust/target/release/libairdraw_godot.dylib"
windows.x86_64 = "res://../rust/target/release/airdraw_godot.dll"
windows.arm64 = "res://../rust/target/release/airdraw_godot.dll"
linux.x86_64 = "res://../rust/target/release/libairdraw_godot.so"
linux.arm64 = "res://../rust/target/release/libairdraw_godot.so"
ios = "res://bin/ios/AirDrawCore.framework"
